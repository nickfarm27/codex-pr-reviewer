#!/usr/bin/env bash
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PEER_ROOT="$(dirname "$SCRIPT_DIR")"
REPO_ROOT="$(dirname "$PEER_ROOT")"
VERSION_PATH="peer/plugins/nickfarm27-pr-review/VERSION"
BASE_REF="${1:-}"

[ -n "$BASE_REF" ] || {
  echo "Usage: check-version-bump <base-commit>" >&2
  exit 2
}

git -C "$REPO_ROOT" cat-file -e "$BASE_REF^{commit}" 2>/dev/null || {
  echo "Base commit is unavailable: $BASE_REF" >&2
  exit 2
}

current_version="$(tr -d '[:space:]' < "$REPO_ROOT/$VERSION_PATH")"
if ! git -C "$REPO_ROOT" cat-file -e "$BASE_REF:$VERSION_PATH" 2>/dev/null; then
  echo "Initial peer distribution version: $current_version"
  exit 0
fi

changed="$(git -C "$REPO_ROOT" diff --name-only "$BASE_REF"...HEAD -- \
  .claude-plugin/marketplace.json \
  prompts/review-core.md \
  peer/README.md \
  peer/SETUP.md \
  peer/setup \
  peer/upgrade \
  peer/uninstall \
  peer/bin/check-update \
  peer/bin/doctor \
  peer/plugins/nickfarm27-pr-review)"
[ -n "$changed" ] || {
  echo "Peer runtime and review policy are unchanged."
  exit 0
}

base_version="$(git -C "$REPO_ROOT" show "$BASE_REF:$VERSION_PATH" | tr -d '[:space:]')"
if ! awk -v current="$current_version" -v base="$base_version" 'BEGIN {
  split(current, current_parts, ".")
  split(base, base_parts, ".")
  for (i = 1; i <= 3; i++) {
    if ((current_parts[i] + 0) > (base_parts[i] + 0)) exit 0
    if ((current_parts[i] + 0) < (base_parts[i] + 0)) exit 1
  }
  exit 1
}'; then
  echo "Peer runtime or review policy changed without a version increase ($base_version -> $current_version)." >&2
  echo "Update VERSION, both plugin manifests, skill metadata, and the marketplace entry." >&2
  exit 1
fi

echo "Peer distribution version changed from $base_version to $current_version."
